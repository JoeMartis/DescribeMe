#!/bin/sh
# Regenerates version.js from the release in VERSION (e.g. 2.0) and the
# commits made since it: the release commit itself reads "2.0", the commits
# after it "2.0.1", "2.0.2" and on, so the badge still says exactly which
# build is loaded. HEAD at this point is the commit being built on top of,
# so the commit about to be created is count(HEAD) + 1.
#
# RELEASE_BASE is that count for the release commit. For a new release,
# change VERSION (say to 2.1) and set RELEASE_BASE to count(HEAD) + 1 in
# the same commit: `git rev-list --count HEAD`, plus one.
#
# Before 2.0 the badge was a plain build number (v1 to v77), counted from
# an offset of 87 commits.
RELEASE_BASE=165
release=$(tr -d ' \r\n' < VERSION 2>/dev/null)
[ -n "$release" ] || release=0
count=$(git rev-list --count HEAD 2>/dev/null || echo 0)
since=$((count + 1 - RELEASE_BASE))
if [ "$since" -le 0 ]; then version="$release"; else version="$release.$since"; fi
echo "window.APP_VERSION = \"$version\";" > version.js
git add version.js
