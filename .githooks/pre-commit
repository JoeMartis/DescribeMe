#!/bin/sh
# Regenerates version.js with a build number derived from the total commit
# count, so it increases with every commit without a manually-tracked
# counter that could drift. HEAD at this point is the commit being built
# on top of, so the commit about to be created is count(HEAD) + 1.
count=$(git rev-list --count HEAD 2>/dev/null || echo 0)
version=$((count + 1))
echo "window.APP_VERSION = \"$version\";" > version.js
git add version.js
