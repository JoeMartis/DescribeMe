#!/bin/sh
# Regenerates version.js with a build number derived from the total commit
# count, so it increases with every commit without a manually-tracked
# counter that could drift. HEAD at this point is the commit being built
# on top of, so the commit about to be created is count(HEAD) + 1.
#
# VERSION_OFFSET subtracts off the commit count as of the reset to v1 (the
# commit before this one), so the badge restarts at 1 here and keeps
# incrementing by 1 per commit from there — without touching git history.
# Bumping it again later means the same thing: set it to the current
# count(HEAD) at the commit you want to become v1.
VERSION_OFFSET=82
count=$(git rev-list --count HEAD 2>/dev/null || echo 0)
version=$((count + 1 - VERSION_OFFSET))
echo "window.APP_VERSION = \"$version\";" > version.js
git add version.js
